{
  "name": "@texaryn/core",
  "version": "1.1.2",
  "description": "Framework-neutral TypeScript runtime for schema-driven forms and display documents, with form state, validation, submission and renderer contracts",
  "keywords": [
    "json-schema",
    "json-schema-form",
    "forms",
    "dynamic-forms",
    "form-generator",
    "form-builder",
    "schema-driven",
    "headless",
    "ui",
    "runtime",
    "typescript",
    "framework-agnostic",
    "server-driven-ui"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hamzahamidi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/texaryn/texaryn.git",
    "directory": "packages/core"
  },
  "homepage": "https://texaryn.github.io/texaryn/",
  "bugs": {
    "url": "https://github.com/texaryn/texaryn/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc --build"
  }
}
