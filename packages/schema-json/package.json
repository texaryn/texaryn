{
  "name": "@texaryn/schema-json",
  "version": "0.7.1",
  "description": "JSON Schema evaluation and validation adapter for Texaryn",
  "keywords": [
    "json-schema",
    "json-schema-form",
    "validation",
    "schema",
    "forms",
    "schema-driven",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hamzahamidi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/texaryn/texaryn.git",
    "directory": "packages/schema-json"
  },
  "homepage": "https://texaryn.github.io/texaryn/",
  "bugs": {
    "url": "https://github.com/texaryn/texaryn/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "CHANGELOG.md", "THIRD-PARTY-NOTICES.md"],
  "dependencies": {
    "@sagold/json-pointer": "^7.2.1",
    "@texaryn/core": "workspace:^",
    "fast-copy": "^4.0.4",
    "fast-deep-equal": "^3.1.3",
    "json-schema-library": "11.6.2",
    "uri-js": "^4.4.1",
    "valid-url": "^1.0.9"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/vendor-schema-json-runtime.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "vitest": "^3.0.0"
  }
}
