{
  "name": "@texaryn/solid",
  "version": "0.1.0",
  "description": "SolidJS bindings, renderer, and default widgets for Texaryn",
  "keywords": ["solid-js", "json-schema", "forms", "form-builder", "schema-driven", "dynamic-forms", "typescript"],
  "type": "module",
  "license": "Apache-2.0",
  "funding": { "type": "github", "url": "https://github.com/sponsors/hamzahamidi" },
  "repository": { "type": "git", "url": "git+https://github.com/texaryn/texaryn.git", "directory": "packages/solid" },
  "homepage": "https://texaryn.github.io/texaryn/",
  "bugs": { "url": "https://github.com/texaryn/texaryn/issues" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "dependencies": { "@texaryn/core": "workspace:^" },
  "peerDependencies": { "solid-js": "^1.9.0" },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@texaryn/schema-json": "workspace:*",
    "jsdom": "^25.0.0",
    "solid-js": "^1.9.9",
    "typescript": "~5.8.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.8"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json --force && vite build",
    "typecheck": "pnpm --filter @texaryn/core build && pnpm --filter @texaryn/schema-json build && tsc --project tsconfig.typecheck.json --noEmit"
  }
}
